# Pagermind — environment configuration
#
# The application needs ZERO environment variables to run: the engine is
# deterministic and the service layer is self-contained. The flags below are
# optional developer conveniences read by src/backend/backend.ts.

# Start the demo with failure injection already enabled (default: false).
VITE_CHAOS_DEFAULT=false

# Reserved for the future transport extraction (Node/Fastify): log level.
VITE_LOG_LEVEL=info
