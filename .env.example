# Pagermind — environment configuration
#
# The application needs ZERO environment variables to run: the engine is
# deterministic and the service layer is self-contained. The two flags below
# are optional developer conveniences read by src/backend/api.ts.

# Start the demo with failure injection already enabled (default: false).
VITE_CHAOS_DEFAULT=false

# Reserved for future transport extraction (Node/Fastify): service log level.
VITE_LOG_LEVEL=info
